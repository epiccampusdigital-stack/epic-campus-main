rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — read own, write own on create
    match /users/{uid} {
      allow get: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher', 'accountant', 'examCoordinator', 'agent', 'kitchen']
      );
      allow list: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher', 'accountant', 'examCoordinator', 'agent', 'kitchen'];
      allow create: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role in ['admin', 'owner', 'reception']
      );
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role in ['admin', 'owner']
      );
    }

    // Students — read/write own record, staff read all, staff with edit access update
    match /students/{studentId} {
      allow read: if request.auth != null && (
        request.auth.uid == studentId ||
        resource.data.uid == request.auth.uid ||
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant', 'teacher', 'examCoordinator', 'agent', 'kitchen']
      );
      allow create: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
      // accountActivationOverride (the Account Activation gate) is carved out of
      // the general self/accountant update grant below: admin/owner/reception/
      // teacher may change it, but a student updating their own record — or an
      // accountant, who can update everything else here — must leave it exactly
      // as it already is. `.get(field, null)` treats "field absent" the same as
      // "field is null" on both sides, so this doesn't block ordinary self-edits
      // on documents that predate this field.
      allow update: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher'] ||
        (
          (request.auth.uid == studentId || resource.data.uid == request.auth.uid || request.auth.token.role == 'accountant') &&
          request.resource.data.get('accountActivationOverride', null) == resource.data.get('accountActivationOverride', null)
        )
      );
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // Account Activation — batch-level default (see src/lib/access/accountActivation.ts).
    // Read is open to any authenticated user because students must resolve their
    // own portal-lock state. Write is spelled out inline on purpose — NOT routed
    // through ACTIVATION_ROLES or any other shared helper/role constant, since
    // reception's permissions were recently audited and must not be silently
    // widened again just because a shared list changes elsewhere.
    match /batchSettings/{batchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception'];
    }

    // Payments — single master collection for both flat transaction receipts and
    // per-student payment plans (a plan doc carries an installments array, keyed by
    // student id). Admin/owner/accountant/reception: read + create + update (reception
    // collects fully-paid / partial payments at the front desk). Delete stays
    // admin/owner/accountant. Teacher: read only. Student: read own. Parent: read own
    // child's via linked users doc.
    match /payments/{paymentId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'accountant', 'reception', 'teacher'] ||
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == resource.data.studentId
      );
      allow create: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant', 'reception'];
      allow update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant', 'reception'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant'];

      // Partial-payment audit trail (append-only). Immutable once written.
      match /partialPayments/{partialId} {
        allow read: if request.auth != null &&
          request.auth.token.role in ['admin', 'owner', 'accountant', 'reception'];
        allow create: if request.auth != null &&
          request.auth.token.role in ['admin', 'owner', 'accountant', 'reception'];
        allow update, delete: if false;
      }
    }

    // Audit log — admin/owner read only, server writes only
    match /auditLog/{logId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
      allow write: if false;
    }

    // Exams — legacy title/type lookup table. Read by parents (resolving a legacy
    // examResults row's title) and staff (partner-companies candidate panel).
    // No student-facing code reads this collection — see audit notes.
    match /exams/{examId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher', 'accountant', 'ai_manager', 'parent'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'teacher', 'examCoordinator'];
    }

    // Exam results — own results or staff
    match /examResults/{resultId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == resource.data.studentId ||
        request.auth.token.role in ['admin', 'teacher', 'examCoordinator', 'owner']
      );
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'teacher', 'examCoordinator', 'owner'];
    }

    // examPapers carries the live access code (accessCode/codeExpiresAt/isLive) for
    // the exam-code entry flow, so read is scoped to every role that legitimately
    // touches the exam system (exam-taking students, exam staff, and the management
    // roles that can reach /admin-exams) rather than left open to any authenticated user.
    match /examPapers/{paperId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception', 'accountant', 'ai_manager', 'examCoordinator', 'student'];
      allow create, update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'examCoordinator'];
    }

    match /examSections/{sectionId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception', 'accountant', 'ai_manager', 'examCoordinator', 'student'];
      allow create, update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'examCoordinator'];
    }

    // KNOWN LIMITATION: Firestore rules cannot hide a single field (correctIndex) from
    // students, and the exam-taking UI must read this collection, so read stays open to
    // every role that touches the exam system — but no longer to every authenticated
    // user (kitchen/agent/company accounts have no exam-system reason to read this).
    // Do not tighten further without moving answer-checking server-side.
    match /examQuestions/{questionId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception', 'accountant', 'ai_manager', 'examCoordinator', 'student'];
      allow create, update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'examCoordinator'];
    }

    match /examAttempts/{attemptId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception', 'examCoordinator'] ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher'] ||
        resource.data.studentId == request.auth.uid
      );
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /examAttemptAnswers/{answerId} {
      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid ||
         request.auth.token.role in ['admin', 'owner', 'teacher', 'examCoordinator']);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'examCoordinator'];
    }

    // Leads — staff only
    match /leads/{leadId} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'ai_manager'];

      // WhatsApp / voice conversation log. Written server-side by the webhook via
      // the Admin SDK (which bypasses these rules); staff read it in the AI Ops
      // Console. Read-only from the client so a transcript can't be altered —
      // this log is the compliance record for regulated recruitment.
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.token.role in ['admin', 'owner', 'ai_manager'];
        allow write: if false;
      }
    }

    // Staff (any management role) read every partner company; a company-portal user
    // reads only their own company doc (docId == their own companyId, set on their
    // users/{uid} doc at account creation). Write left as-is (bare auth) — not part of
    // this pass, flagged separately.
    match /partnerCompanies/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant', 'teacher', 'ai_manager'] ||
        (request.auth.token.role == 'company' &&
          docId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId)
      );
      allow write: if request.auth != null;
    }

    // Staff (any management role) read every shortlist entry; a company-portal user
    // reads only entries tagged with their own companyId. Write left as-is (bare
    // auth) — not part of this pass, flagged separately.
    match /candidateShortlists/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant', 'teacher', 'ai_manager'] ||
        (request.auth.token.role == 'company' &&
          resource.data.companyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId)
      );
      allow write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read, write: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         request.auth.token.role in ['admin', 'owner']);
      allow create: if request.auth != null;
    }

    match /parentAccounts/{accountId} {
      allow read: if request.auth != null && (
        request.auth.uid == accountId ||
        request.auth.token.role in ['admin', 'owner', 'reception']
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
    }

    // Student reads own record (studentId is a students/{id} doc id, not the auth
    // uid, so cross-referenced the same way as payments/examResults/visaDocuments);
    // parents read their linked child's record via the same crosswalk; staff (any
    // management role — attendance admin page, dashboard risk widget, student
    // profile, /admin/student-risk all reach this with no further gate) read all.
    match /attendance/{recordId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant', 'teacher', 'ai_manager'] ||
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == resource.data.studentId
      );
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher'];
    }

    match /broadcastMessages/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
    }

    match /broadcastLogs/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
      allow write: if false;
    }

    // Public inquiries from contact form
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'phone', 'program'])
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.program is string;
      allow read, update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
    }

    // AI chat history — student reads/writes own history, staff can read
    match /aiChatHistory/{studentId}/messages/{messageId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == studentId ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
    }

    // Study sessions — student reads/writes own sessions, staff can read
    match /studySessions/{sessionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentId ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.studentId;
    }

    // Enrollment applications — public create (unauthenticated via API), staff read/update
    match /enrollmentApplications/{enrollmentId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher', 'accountant'] ||
        request.auth.uid == resource.data.studentId
      );
      allow create: if true;
      allow update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
    }

    // Public chatbot logs — admin/owner read only, only server writes
    match /publicChatLogs/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
      allow write: if false;
    }

    // Study materials — no code in the app currently reads or writes this
    // collection (dead/legacy — the live "materials" feature uses the `materials`
    // collection instead). Read scoped to match the existing write role in case it
    // is revived.
    match /studyMaterials/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
    }

    // Kitchen module
    match /inventory/{doc} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner'];
    }

    match /inventory/{doc}/history/{h} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner'];
    }

    // Unified stock-change log (kitchen inventory + supplies). Immutable audit trail.
    match /inventoryLogs/{logId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner', 'accountant', 'reception'];
      allow create: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner', 'accountant', 'reception'];
      allow update, delete: if false;
    }

    match /kitchen_intake/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant', 'kitchen'];
      allow create: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'kitchen'];
      allow update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'kitchen'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /mealLogs/{doc} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner', 'accountant'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner'];
    }

    match /wasteLog/{doc} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'kitchen', 'accountant'];
    }

    match /kitchenOrders/{doc} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner', 'accountant'];
      allow create, update: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /kitchenBudget/{doc} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['kitchen', 'admin', 'owner', 'accountant'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // Which batches are physically on campus. Kitchen head counts and order
    // scaling read this; only admin/owner may change it.
    match /settings/campusStatus {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher', 'accountant', 'examCoordinator', 'agent', 'kitchen', 'student'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /dailyMenus/{menuId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'kitchen', 'owner'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'kitchen', 'owner'];
    }

    match /mealTemplates/{templateId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'kitchen', 'owner'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'kitchen', 'owner'];
    }

    match /expenses/{doc} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant'];
    }

    // Finance roles get full access. Agents keep read of their OWN commission rows
    // only (their portal depends on it) — never other agents' or aggregate data.
    match /agentCommissions/{doc} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'accountant'] ||
        (request.auth.token.role == 'agent' && resource.data.agentId == request.auth.uid)
      );
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant'];
    }

    match /staffReferrals/{doc} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'accountant'] ||
        resource.data.staffId == request.auth.uid
      );
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant'];
    }

    match /payroll/{doc} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant'];
    }

    // No code anywhere reads this collection client-side (legacy — parent login
    // now resolves via students.parentAccessCode instead). Read locked to the same
    // staff roles that already write it. NEVER students.
    match /parentPortalCodes/{code} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
    }

    match /riskCache/{doc} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
    }

    // Student portal never reads this (it uses consultationRequests instead) — only
    // the /consultations management page does, reachable by any management role.
    match /roomSlots/{slotId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant', 'teacher', 'ai_manager'];
      allow create, update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher'];
    }

    match /roomBookings/{bookingId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher'] ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception'] ||
        resource.data.studentId == request.auth.uid
      );
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // 1:1 teacher/student tutoring sessions (distinct from the class `schedule`
    // collection). Student reads own (studentId crosswalked like attendance/
    // payments); staff (teacher included, since /teacher and /sessions browse
    // every staff member's sessions, not just the caller's own) read all.
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception'] ||
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == resource.data.studentId
      );
      allow create, update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception'];
    }

    match /visaDocuments/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant'] ||
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == resource.data.studentId
      );
      allow create, update: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception'] ||
        request.resource.data.studentId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'reception'] ||
        resource.data.studentId == request.auth.uid
      );
    }

    match /epicWallPosts/{postId} {
      allow read: if true;  // public read for the public /epic-wall page
      // Students publish from /epic-wall, admin/owner from /admin/epic-wall — both go
      // through the shared WallComposer, which stamps authorId with the caller's uid.
      allow create: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner'] ||
        request.resource.data.authorId == request.auth.uid
      );
      allow update: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher', 'reception'] ||
        resource.data.authorId == request.auth.uid
      );
      // admin/owner may delete ANY post; everyone else only their own.
      allow delete: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner'] ||
        resource.data.authorId == request.auth.uid
      );
    }

    match /epicWallComments/{commentId} {
      allow read: if true;  // public read for the public /epic-wall page
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner'] ||
        resource.data.authorId == request.auth.uid
      );
    }

    // Read behaviour unchanged (only ever exercised by the authenticated
    // /epic-wall page, wall is public-by-design at the epicWallPosts level).
    // Write tightened to ownership — every call site already stamps userId with
    // the caller's own uid (toggle-like/poll-vote reactions), so this matches
    // current behavior exactly.
    match /epicWallReactions/{reactionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Read behaviour unchanged (see epicWallReactions above). Create tightened to
    // ownership — the only call site always stamps authorId with the caller's own
    // uid, matching current behavior exactly. Delete was already ownership-scoped.
    match /epicWallStories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner'] ||
        resource.data.authorId == request.auth.uid
      );
    }

    // /my-materials (student) and /materials (admin/owner/teacher) both fetch this
    // collection with NO where() clause and filter client-side, so a per-course
    // ownership rule isn't achievable without also rewriting those queries — role
    // check only. Excludes kitchen/agent/accountant/ai_manager/company, none of
    // which have any reason to read course materials.
    match /materials/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','teacher','reception','examCoordinator','student'];
      allow create, update, delete: if request.auth != null &&
        request.auth.token.role in ['admin','owner','teacher','reception','examCoordinator'];
    }

    // Student-uploaded files sent to a teacher from My Materials → My Submissions.
    // Ownership enforced the same way as epicWallPosts (authorId there, studentId
    // here). Teacher/admin/owner can read every submission (no batch → teacher
    // assignment table exists yet) and update readByTeacher; only the owning
    // student may create or delete their own doc.
    match /studentSubmissions/{submissionId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid;
      allow update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
      allow delete: if request.auth != null &&
        resource.data.studentId == request.auth.uid;
    }

    match /consultationRequests/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentId ||
        request.auth.token.role in ['admin','owner','reception','teacher']
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.token.role in ['admin','owner','reception'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin','owner'];
    }

    match /messages/{studentId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == studentId ||
         request.auth.token.role in ['admin', 'owner', 'teacher', 'reception']);
    }

    match /messages/{studentId}/{subCol}/{docId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == studentId ||
         request.auth.token.role in ['admin', 'owner', 'teacher', 'reception']);
    }

    match /visaApplications/{docId} {
      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid ||
         request.auth.token.role in ['admin', 'owner', 'reception']);
      allow write: if request.auth != null &&
        (request.auth.token.role in ['admin', 'owner', 'reception'] ||
         resource.data.studentId == request.auth.uid);
    }

    match /conversations/{docId} {
      allow read, write: if request.auth != null &&
        (resource.data.studentId == request.auth.uid ||
         request.auth.token.role in ['admin', 'owner', 'teacher', 'reception']);
    }

    // Dead collection — no page, component, or API route anywhere in the codebase
    // reads or writes messageThreads (the live student<->staff messaging system
    // uses `messages/{studentId}` + thread_admin/thread_teacher subcollections
    // instead, already correctly scoped below). Locked closed entirely.
    match /messageThreads/{threadId} {
      allow read, write: if false;
    }
    match /messageThreads/{threadId}/messages/{msgId} {
      allow read, write: if false;
    }

    // /my-schedule (student) and /schedule (management) both fetch this collection
    // with NO where() clause and filter client-side (course match + consultation
    // privacy), so a per-course ownership rule isn't achievable without also
    // rewriting those queries — role check only, matching the write role list.
    match /schedule/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','teacher','reception','examCoordinator','student'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','teacher','reception','examCoordinator'];
    }

    // Staff (finance/reception/teacher/ai_manager — /accommodation and
    // /accommodation/[houseId] have no page-level gate narrower than the
    // management layout) read every house; a student reads only their own
    // assigned house, resolved via students/{id}.houseId (crosswalked from
    // users/{uid}.studentId, same pattern as elsewhere in this ruleset).
    match /accommodations/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin','owner','reception','accountant','teacher','ai_manager'] ||
        (request.auth.token.role == 'student' &&
          docId == get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)).data.houseId)
      );
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','reception','accountant'];
    }

    match /accommodations/{houseId}/inventory/{itemId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant','reception'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant'];
    }

    match /accommodations/{houseId}/bills/{billId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant'];
    }

    match /accommodations/{houseId}/rentPayments/{payId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant','reception'];
    }

    match /accommodationBudget/{month} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant','reception'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant'];
    }

    // /supplies page itself gates rendering to exactly this role set (kitchen and
    // ai_manager are explicitly excluded there) — read matches that.
    match /supplies/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant','reception','teacher'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','kitchen','reception'];
    }

    match /utilityBills/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant'];
    }

    match /fixedUtilityBills/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','accountant'];
    }

    match /agents/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','reception'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner'];
    }

    // No client code currently reads this collection at all (write-only, via the
    // admin bulk-import tool) — locked to the same roles as write.
    match /kitchenInventory/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin','owner','kitchen'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin','owner','kitchen'];
    }

    match /pendingApprovals/{docId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /certificates/{certId} {
      allow read: if true; // public verification
      allow create, update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /paymentReceipts/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentId ||
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant']
      );
      allow update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /otpVerifications/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /twoFactorCodes/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /lessonPlans/{docId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
    }

    // AI Knowledge Base — Owner/Admin only. Structured content blocks that later
    // phases assemble into the WhatsApp / voice agent system prompts. Editing
    // these changes what the agent knows; no model training is involved.
    match /aiKnowledgeBase/{blockId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'ai_manager'];
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'ai_manager'];
    }

    // Previous versions of knowledge blocks, archived on every save.
    // Append-only — history is never rewritten or deleted from the client.
    match /aiKnowledgeBase_history/{versionId} {
      allow read: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'ai_manager'];
      allow create: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'ai_manager'];
      allow update, delete: if false;
    }

    // Japan Online Course (JP) catalog — any signed-in user reads (student course
    // browser); publishing/authoring is admin/owner only.
    match /jpCourses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /jpCourses/{courseId}/modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    match /jpCourses/{courseId}/modules/{moduleId}/lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // JP enrollments — grants of paid access to a JP course. Finance/teaching
    // staff read all; a student reads only their own enrollment. studentId is
    // a students/{id} document ID, which is not guaranteed to equal the
    // owning student's Auth UID (most existing student docs predate uid
    // linkage), so ownership is verified via a get() on that student doc's
    // own `uid` field rather than comparing studentId to request.auth.uid
    // directly. Students must NEVER be able to write their own enrollment
    // doc — that would let a student grant themselves paid access — so
    // create/update/delete is finance-role only, with no owning-student
    // carve-out (unlike most student-owned collections elsewhere in this
    // ruleset).
    match /jpEnrollments/{enrollmentId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'accountant', 'accounts', 'teacher'] ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.uid == request.auth.uid
      );
      allow create, update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant', 'accounts'];
    }

    // JP lesson progress — the owning student reads/writes their own drip-release
    // progress; admin/owner/teacher read only (never write another student's
    // progress).
    match /jpProgress/{studentId} {
      allow read: if request.auth != null && (
        request.auth.uid == studentId ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
      allow write: if request.auth != null && request.auth.uid == studentId;
    }

    match /jpProgress/{studentId}/lessons/{lessonId} {
      allow read: if request.auth != null && (
        request.auth.uid == studentId ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
      allow write: if request.auth != null && request.auth.uid == studentId;
    }

    // JP orders — one order per checkout (course fee + postage as a single
    // transaction). studentId is a students/{id} document ID, not the owning
    // student's Auth UID (same mismatch as jpEnrollments — see that rule's
    // comment above), so ownership is verified via the same get()-on-uid
    // pattern rather than comparing studentId to request.auth.uid directly.
    // A student may create their own order to start checkout, but can never
    // change its status, amounts, or paymentRef afterward — those writes
    // (markOrderPaid / rejectOrder) always happen server-side as finance
    // staff or a payment webhook, never as the student themselves.
    match /jpOrders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'accountant'] ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.uid == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'accountant'] ||
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.uid == request.auth.uid
      );
      allow update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'accountant'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // JP fulfilment — study-pack dispatch tracking for a paid order, keyed
    // 1:1 by orderId. Reception (plus admin/owner) packs and dispatches;
    // accountant and the owning student (same ownership pattern as
    // jpOrders/jpEnrollments) may only read.
    match /jpFulfilment/{orderId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'accountant', 'reception'] ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.uid == request.auth.uid
      );
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'reception'];
    }

    // JP settings — single config doc (postage rate, bank details, dispatch
    // promise/refund policy text) shown to any signed-in student during
    // checkout; only admin/owner may edit it.
    match /jpSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // JP support threads — studentId is a students/{id} document ID, not the
    // owning student's Auth UID (same mismatch as jpEnrollments/jpOrders —
    // see the jpEnrollments comment above), so ownership is verified via the
    // same get()-on-uid pattern rather than comparing studentId to
    // request.auth.uid directly. A student may create their own thread and
    // update it (add a message, close it) — teaching staff read/manage all.
    match /jpSupportThreads/{threadId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher'] ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.uid == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher'] ||
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.uid == request.auth.uid
      );
      allow update: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher'] ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.uid == request.auth.uid
      );
    }

    match /jpSupportThreads/{threadId}/messages/{messageId} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher'] ||
        get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/jpSupportThreads/$(threadId)).data.studentId)).data.uid == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'teacher'] ||
        get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/jpSupportThreads/$(threadId)).data.studentId)).data.uid == request.auth.uid
      );
      allow update, delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // JP campus sessions — the monthly in-person day for online students.
    // Any signed-in user reads; only teaching/admin staff create the
    // sessions themselves.
    match /jpCampusSessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner', 'teacher'];
    }

    // RSVPs are keyed by the student's own Auth UID (not a students/{id}
    // document ID), so ownership here is a direct uid comparison — no
    // get()-on-uid indirection needed, unlike the collections above.
    match /jpCampusSessions/{sessionId}/rsvps/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
    }
  }
}
