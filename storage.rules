rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Student profile photos. Folder name is the students/{docId} Firestore
    // doc id, which is normally the student's own auth uid but can differ
    // for accounts originally created via CRM import (see loadStudentProfile.ts) —
    // for those, self-upload falls through to the "profile_unavailable" state
    // and only staff can set the photo until the doc id is backfilled.
    match /students/{studentDocId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.auth.uid == studentDocId ||
        request.auth.token.role in ['admin', 'owner', 'reception', 'teacher']
      ) &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (
        request.auth.uid == studentDocId ||
        request.auth.token.role in ['admin', 'owner']
      );
    }

    // Staff profile photos — only managed from the /staff admin page (admin/owner only).
    match /staff/{staffDocId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'] &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null &&
        request.auth.token.role in ['admin', 'owner'];
    }

    // Visa/passport/NIC documents — identity documents, so read is restricted.
    match /visaDocs/{studentId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == studentId ||
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant']
      );
      allow create, update: if request.auth != null && request.auth.uid == studentId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && (
        request.auth.uid == studentId ||
        request.auth.token.role in ['admin', 'owner']
      );
    }

    match /materials/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.auth.token.role in ['admin','owner','teacher','reception','examCoordinator']
      );
      allow delete: if request.auth != null && (
        request.auth.token.role in ['admin','owner']
      );
    }

    // Epic Wall post images. Folder name is always the poster's own auth uid
    // (WallComposer uploads under `${author.uid}`, staff and students alike).
    match /epicWall/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role in ['admin', 'owner']
      );
    }

    // Epic Wall stories. Folder name is always the poster's own auth uid.
    match /epicStories/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role in ['admin', 'owner']
      );
    }

    match /examQuestions/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.auth.token.role in ['admin','owner','teacher','examCoordinator']
      );
      allow delete: if request.auth != null && (
        request.auth.token.role in ['admin','owner']
      );
    }

    match /kitchen/{allPaths=**} {
      allow read, create, update: if request.auth != null && (
        request.auth.token.role in ['admin','owner','kitchen']
      );
      allow delete: if request.auth != null && (
        request.auth.token.role in ['admin','owner']
      );
    }

    match /ssw-migration/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.role in ['admin','owner']
      );
    }

    match /payment-receipts/{userId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
        request.auth.token.role in ['admin', 'owner', 'reception', 'accountant']);
      allow create, update: if request.auth != null && request.auth.uid == userId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.role in ['admin', 'owner']
      );
    }

    // Student → teacher file submissions from My Materials → My Submissions.
    // A student may only write into their own uid folder; staff read only.
    // Split from `write` because request.resource is null on delete, so the
    // size/contentType checks can't apply to that request type.
    match /studentSubmissions/{studentUid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == studentUid ||
        request.auth.token.role in ['admin', 'owner', 'teacher']
      );
      allow create, update: if request.auth != null && request.auth.uid == studentUid &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/png|image/jpeg');
      allow delete: if request.auth != null && request.auth.uid == studentUid;
    }
  }
}
